{
  "name": "price-extension",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension that rewrites prices on web pages into an equivalent weight of a precious metal.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run clean && npm run sync:version && npm run build:pages && npm run build:content",
    "build:pages": "vite build",
    "build:content": "vite build --config vite.content.config.ts",
    "clean": "node scripts/clean.mjs",
    "sync:version": "node scripts/sync-version.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "zip": "npm run build && node scripts/zip.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
